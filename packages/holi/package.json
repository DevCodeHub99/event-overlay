{
  "name": "@event-overlay/holi",
  "version": "1.0.6",
  "type": "module",
  "description": "🎨 Vibrant, ultra-high-performance Holi festival celebration overlay with water balloons, pichkaari streams, and gulal colors. Zero dependencies.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./umd": "./dist/index.umd.js"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "holi",
    "holi-overlay",
    "holi-festival",
    "festival-of-colours",
    "rangotsav",
    "gulal",
    "pichkaari",
    "water-balloon",
    "colors-festival",
    "celebration-overlay",
    "festive-overlay",
    "canvas-confetti",
    "particle-effects",
    "particle-system",
    "react-holi",
    "react-celebration",
    "react-festive",
    "nextjs-overlay",
    "indian-festivals",
    "happy-holi",
    "web-animation",
    "canvas-overlay",
    "zero-dependency",
    "colors",
    "react",
    "canvas"
  ],
  "author": "Vikas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevCodeHub99/event-overlay.git",
    "directory": "packages/holi"
  }
}