{
  "name": "@event-overlay/core",
  "version": "1.0.6",
  "type": "module",
  "description": "🎆 Headless, high-performance celebration overlay engine with 60 FPS Canvas loop, WCAG 2.2.2 controls, and Page Visibility pausing. Zero dependencies.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "event-overlay",
    "celebration-overlay",
    "festive-overlay",
    "canvas-animation",
    "particle-effects",
    "headless",
    "zero-dependency",
    "canvas-overlay",
    "canvas"
  ],
  "author": "Vikas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevCodeHub99/event-overlay.git",
    "directory": "packages/core"
  }
}