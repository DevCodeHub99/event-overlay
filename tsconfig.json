{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src/**/*",
    "packages/**/*",
    "IndependenceDayOverlay.tsx",
    "HoliOverlay.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist"
  ]
}