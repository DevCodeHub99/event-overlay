{
    "name": "@event-overlay/core",
    "version": "1.0.2",
    "type": "module",
    "description": "🎆 High-performance celebration overlay framework with dedicated packages for Independence Day, Holi, and custom festive celebrations. Zero dependencies.",
    "main": "dist/event-overlay.cjs",
    "module": "dist/event-overlay.js",
    "types": "dist/event-overlay.d.ts",
    "browser": "dist/event-overlay.umd.js",
    "workspaces": [
        "packages/*"
    ],
    "exports": {
        ".": {
            "import": "./dist/event-overlay.js",
            "require": "./dist/event-overlay.cjs",
            "types": "./dist/event-overlay.d.ts",
            "default": "./dist/event-overlay.js"
        },
        "./independence-day": {
            "import": "./dist/events/independence-day.js",
            "types": "./dist/events/independence-day.d.ts"
        },
        "./holi": {
            "import": "./dist/events/holi.js",
            "types": "./dist/events/holi.d.ts"
        },
        "./react": {
            "import": "./src/react/index.jsx",
            "types": "./dist/event-overlay.d.ts"
        },
        "./react/independence-day": {
            "import": "./src/react/independence-day.jsx",
            "types": "./dist/events/independence-day.d.ts"
        },
        "./react/holi": {
            "import": "./src/react/holi.jsx",
            "types": "./dist/events/holi.d.ts"
        },
        "./umd": "./dist/event-overlay.umd.js",
        "./umd/independence-day": "./dist/events/independence-day.umd.js",
        "./umd/holi": "./dist/events/holi.umd.js"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "packages",
        "IndependenceDayOverlay.tsx",
        "HoliOverlay.tsx",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "node build.js",
        "dev": "npx -y http-server . -p 3000 -o /index.html",
        "publish:independence-day": "npm publish ./packages/independence-day --access public",
        "publish:holi": "npm publish ./packages/holi --access public",
        "publish:core": "npm publish ./packages/core --access public",
        "publish:all": "npm run build && npm publish --workspaces --access public"
    },
    "keywords": [
        "event-overlay",
        "celebration-overlay",
        "festive-overlay",
        "holi",
        "holi-overlay",
        "holi-festival",
        "festival-of-colours",
        "rangotsav",
        "gulal",
        "pichkaari",
        "water-balloon",
        "independence-day",
        "indian-independence-day",
        "15-august",
        "republic-day",
        "26-january",
        "tiranga",
        "indian-flag",
        "tricolor",
        "kites",
        "patriotism",
        "airshow",
        "fighter-jets",
        "fireworks",
        "confetti",
        "canvas-confetti",
        "particle-effects",
        "particle-system",
        "react-celebration",
        "react-festive",
        "react-holi",
        "react-independence-day",
        "nextjs-overlay",
        "nextjs-animation",
        "canvas-animation",
        "web-animation",
        "zero-dependency",
        "monorepo",
        "canvas-overlay",
        "canvas",
        "react"
    ],
    "author": "Vikas",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DevCodeHub99/event-overlay.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://github.com/DevCodeHub99/event-overlay#readme",
    "bugs": {
        "url": "https://github.com/DevCodeHub99/event-overlay/issues"
    },
    "devDependencies": {}
}